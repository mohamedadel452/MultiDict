<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Reusable Shape Appearances -->
    <style name="ShapeAppearance.MultiDict.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.MultiDict.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_dialog</item>
    </style>

    <style name="ShapeAppearance.MultiDict.Button" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_button</item>
    </style>

    <!-- Reusable Widget Styles -->
    <style name="Widget.MultiDict.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.MultiDict.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.MultiDict.Label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.MultiDict.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="android:textAppearance">@style/TextAppearance.MultiDict.Label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="rippleColor">@color/primary</item>
    </style>

    <style name="Widget.MultiDict.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.MultiDict.Label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.MultiDict.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAppearance">@style/TextAppearance.MultiDict.Label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.MultiDict.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/inverse_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MultiDict.Button</item>
        <item name="android:layout_marginStart">@dimen/space_16</item>
        <item name="android:layout_marginEnd">@dimen/space_16</item>
        <item name="android:layout_marginBottom">@dimen/space_16</item>
        <item name="elevation">@dimen/elevation_floating</item>
    </style>

    <style name="Widget.MultiDict.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/inverse_on_surface</item>
        <item name="android:fontFamily">@font/font_family_ui</item>
    </style>

    <style name="Widget.MultiDict.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog.Centered">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MultiDict.Dialog</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MultiDict.Button.Tonal</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MultiDict.Button.Text</item>
    </style>
</resources>

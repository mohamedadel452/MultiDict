<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography Scale (sp) -->
    <dimen name="text_size_display">28sp</dimen>
    <dimen name="line_height_display">34sp</dimen>

    <dimen name="text_size_title">20sp</dimen>
    <dimen name="line_height_title">26sp</dimen>

    <dimen name="text_size_body">16sp</dimen>
    <dimen name="line_height_body">24sp</dimen>

    <dimen name="text_size_label">13sp</dimen>
    <dimen name="line_height_label">16sp</dimen>

    <dimen name="text_size_caption">12sp</dimen>
    <dimen name="line_height_caption">16sp</dimen>

    <!-- TextAppearances (Latin: Plus Jakarta Sans + Fraunces Display) -->
    <style name="TextAppearance.MultiDict.DisplayWord" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/font_family_display</item>
        <item name="android:fontFamily">@font/font_family_display</item>
        <item name="android:textSize">@dimen/text_size_display</item>
        <item name="lineHeight">@dimen/line_height_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.MultiDict.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/font_family_ui</item>
        <item name="android:fontFamily">@font/font_family_ui</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="lineHeight">@dimen/line_height_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MultiDict.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/font_family_ui</item>
        <item name="android:fontFamily">@font/font_family_ui</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="lineHeight">@dimen/line_height_body</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MultiDict.BodyBold" parent="TextAppearance.MultiDict.Body">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MultiDict.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/font_family_ui</item>
        <item name="android:fontFamily">@font/font_family_ui</item>
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="lineHeight">@dimen/line_height_label</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.MultiDict.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/font_family_ui</item>
        <item name="android:fontFamily">@font/font_family_ui</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="lineHeight">@dimen/line_height_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TextAppearance.MultiDict.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/font_family_ui</item>
        <item name="android:fontFamily">@font/font_family_ui</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="lineHeight">@dimen/line_height_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.MultiDict.Badge" parent="TextAppearance.MultiDict.Caption">
        <item name="android:textStyle">bold</item>
    </style>
</resources>

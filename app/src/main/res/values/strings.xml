    <!-- Phase 5 & 9: Onboarding & Coach Marks -->
    <string name="onboard_skip">Skip</string>
    <string name="onboard_next">Next</string>
    <string name="onboard_get_started">Get started</string>
    <string name="onboard_title_1">One word, every dictionary</string>
    <string name="onboard_desc_1">Type a German word once and search it across all your dictionaries simultaneously.</string>
    <string name="onboard_title_smart_ml">Voice, Camera OCR &amp; Instant Translate</string>
    <string name="onboard_desc_smart_ml">Speak in German, English, or Arabic, scan any book or photo with the camera to tap words directly, and see instant offline translations.</string>
    <string name="onboard_title_2">Switch with one tap</string>
    <string name="onboard_desc_2">Tap or swipe the bottom bar to compare definitions, synonyms, and conjugations — with smart automatic language detection.</string>
    <string name="onboard_title_3">Save and review</string>
    <string name="onboard_desc_3">Bookmark favorites with offline notes, listen to native pronunciation, and practice with flashcards.</string>
    <string name="onboard_title_4">Ready to learn?</string>
    <string name="onboard_desc_4">Master German vocabulary faster with English &amp; Arabic UI, dark mode, and every dictionary at your fingertips.</string>

    <string name="coach_step_counter">%1$d of %2$d</string>

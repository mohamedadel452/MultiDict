    <!-- Phase 7: About Screen & Developer Info (Edit in one place) -->
    <string name="about_title">About the app</string>
    <string name="about_sub">Developer info, mission &amp; version</string>
    <string name="about_version_format">Version %1$s</string>
    <string name="about_card_what_title">What is this app?</string>
    <string name="about_card_what_body">MultiDict lets you type one word and look it up in many trusted dictionaries with a single tap. It was made to make learning languages easier and faster.</string>
    <string name="about_card_author_title">Made with love by</string>
    <string name="about_developer_name">Eng. Mohamed Adel</string>
    <string name="about_card_author_body">I built this app to help people who are learning languages.</string>
    <string name="about_card_gift_title">A free gift</string>
    <string name="about_card_gift_body">This app is completely free, with no ads and no fees, and it will always be a charitable project. I only ask one thing: if the app helps you, please make a kind prayer (dua) for me.</string>
    <string name="about_closing_line">Use it, benefit from it, and share it with someone who is learning.</string>
    <string name="about_btn_share">Share the app</string>
    <string name="about_btn_rate">Rate the app</string>
    <string name="about_share_message">MultiDict — Type one word and look it up across many trusted dictionaries with a single tap, completely free and ad-free.</string>
    <string name="about_footer_copyright">© 2026 Eng. Mohamed Adel</string>


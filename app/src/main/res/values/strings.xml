    <string name="coach_title_1">Quick Search</string>
    <string name="coach_desc_1">Type any word here — smart language detection and quick translation appear automatically above the page.</string>
    <string name="coach_title_voice">Voice Search (DE / EN / AR)</string>
    <string name="coach_desc_voice">Tap the mic to speak a word live, or tap the language badge (DE / EN / AR) next to it to switch the spoken language.</string>
    <string name="coach_title_ocr">Camera &amp; Image OCR Scan</string>
    <string name="coach_desc_ocr">Take a photo or choose an image from your gallery, then tap any highlighted word or phrase to look it up immediately.</string>
    <string name="coach_title_2">Dictionary Bar</string>
    <string name="coach_desc_2">Tap or swipe to compare the same word across Duden, DWDS, PONS, ArabDict, and more.</string>
    <string name="coach_title_3">Save Favorites</string>
    <string name="coach_desc_3">Save words with your own personal notes and review them in Flashcards.</string>
    <string name="coach_title_4">Pronunciation</string>
    <string name="coach_desc_4">Tap the speaker icon to hear clear German pronunciation anytime.</string>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Toolbar with standard back arrow -->
    <LinearLayout
        android:id="@+id/toolbarAbout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/screen_padding_horizontal">

        <ImageButton
            android:id="@+id/btnBackAbout"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/about_title"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.MultiDict.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/about_title" />
    </LinearLayout>

    <!-- Single Scrollable Screen, centered, generous spacing -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/space_32">

            <!-- 1. App Icon (large, in rounded container), App Name & Version -->
            <LinearLayout
                android:id="@+id/headerAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/about_icon_container_size"
                    android:layout_height="@dimen/about_icon_container_size"
                    android:outlineAmbientShadowColor="@color/ambient_shadow"
                    android:outlineSpotShadowColor="@color/spot_shadow"
                    app:cardCornerRadius="@dimen/radius_bottom_bar"
                    app:cardElevation="@dimen/elevation_floating"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="@dimen/hairline">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/app_name"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_background" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/app_name"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_launcher_foreground" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/TextAppearance.MultiDict.DisplayWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/tvAboutVersion"
                    style="@style/TextAppearance.MultiDict.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- 2. Card: "What is this app?" -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAboutWhat"
                style="@style/Widget.MultiDict.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                app:cardBackgroundColor="@color/surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <TextView
                        style="@style/TextAppearance.MultiDict.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/about_card_what_title" />

                    <TextView
                        style="@style/TextAppearance.MultiDict.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:gravity="center"
                        android:text="@string/about_card_what_body"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Card: "Made with love by" -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAboutAuthor"
                style="@style/Widget.MultiDict.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:cardBackgroundColor="@color/surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <TextView
                        style="@style/TextAppearance.MultiDict.SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/about_card_author_title"
                        android:textColor="@color/secondary" />

                    <TextView
                        style="@style/TextAppearance.MultiDict.DisplayWord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:text="@string/about_developer_name" />

                    <View
                        android:layout_width="@dimen/coral_underline_width"
                        android:layout_height="@dimen/coral_underline_height"
                        android:layout_marginTop="@dimen/space_6"
                        android:background="@drawable/bg_coral_underline" />

                    <TextView
                        style="@style/TextAppearance.MultiDict.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center"
                        android:text="@string/about_card_author_body"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Card: "A free gift" (with a small heart icon) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAboutGift"
                style="@style/Widget.MultiDict.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:cardBackgroundColor="@color/surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size_standard"
                            android:layout_height="@dimen/icon_size_standard"
                            android:contentDescription="@string/about_card_gift_title"
                            android:src="@drawable/ic_heart" />

                        <TextView
                            style="@style/TextAppearance.MultiDict.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:gravity="center"
                            android:text="@string/about_card_gift_title" />
                    </LinearLayout>

                    <TextView
                        style="@style/TextAppearance.MultiDict.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:gravity="center"
                        android:text="@string/about_card_gift_body"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Gentle closing line in a soft accent style -->
            <TextView
                android:id="@+id/tvAboutClosing"
                style="@style/TextAppearance.MultiDict.BodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="@string/about_closing_line"
                android:textColor="@color/secondary" />

            <!-- 6. Two buttons: "Share the app" and "Rate the app" (hidden until published) -->
            <LinearLayout
                android:id="@+id/layoutAboutActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareApp"
                    style="@style/Widget.MultiDict.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:text="@string/about_btn_share"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_8"
                    app:iconTint="@color/on_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRateApp"
                    style="@style/Widget.MultiDict.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/about_btn_rate"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 7. Footer small text -->
            <TextView
                android:id="@+id/tvAboutFooter"
                style="@style/TextAppearance.MultiDict.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center"
                android:text="@string/about_footer_copyright"
                android:textColor="@color/text_hint" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

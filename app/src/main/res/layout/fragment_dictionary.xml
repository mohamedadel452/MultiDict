<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Ultra-thin (2dp) gradient ProgressBar from primary to coral accent -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_bar_height"
        android:max="100"
        android:progressDrawable="@drawable/bg_progress_gradient"
        android:visibility="gone" />

    <!-- WebView + Shimmer skeleton placeholder + Error state overlay wrapped in smart direction lock -->
    <com.example.multidict.NestedWebViewHost
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Lightweight soft skeleton shimmer placeholder while page first loads -->
        <LinearLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="@dimen/space_24"
            android:visibility="gone">

            <View
                android:layout_width="140dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_tab_selected" />

            <View
                android:layout_width="90dp"
                android:layout_height="14dp"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_search_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_search_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_search_input" />

            <View
                android:layout_width="240dp"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_search_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_tab_selected" />
        </LinearLayout>

        <!-- Friendly Error State with centered line illustration and filled Retry button -->
        <LinearLayout
            android:id="@+id/errorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_32"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/empty_illustration_size"
                android:layout_height="@dimen/empty_illustration_size"
                android:contentDescription="@string/error_loading_page"
                android:src="@drawable/ic_error_offline" />

            <TextView
                android:id="@+id/tvErrorMessage"
                style="@style/TextAppearance.MultiDict.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="@string/error_loading_page"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.MultiDict.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_20"
                android:paddingStart="@dimen/space_24"
                android:paddingEnd="@dimen/space_24"
                android:text="@string/retry" />
        </LinearLayout>
    </com.example.multidict.NestedWebViewHost>

</LinearLayout>

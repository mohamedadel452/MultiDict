<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Top header bar: Back + "Favorites" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/screen_padding_horizontal">

        <ImageButton
            android:id="@+id/btnBackFavorites"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.MultiDict.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/menu_favorites" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSwipeHint"
        style="@style/TextAppearance.MultiDict.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_8"
        android:text="@string/favorites_swipe_hint"
        android:textColor="@color/text_secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_16">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MultiDict.Card"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFavorites"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Friendly Empty State with vector line illustration + one-line hint -->
        <LinearLayout
            android:id="@+id/tvEmptyFavorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_24"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/empty_illustration_size"
                android:layout_height="@dimen/empty_illustration_size"
                android:contentDescription="@string/empty_favorites"
                android:src="@drawable/ic_empty_state" />

            <TextView
                style="@style/TextAppearance.MultiDict.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="@string/empty_favorites"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>

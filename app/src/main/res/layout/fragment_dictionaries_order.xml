<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Top header bar: "Wörterbücher" + "+ Add custom dictionary" tonal button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/screen_padding_horizontal">

        <ImageButton
            android:id="@+id/btnBackDictionaries"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.MultiDict.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:text="@string/menu_dictionaries" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCustomDictionary"
            style="@style/Widget.MultiDict.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:text="@string/add_custom_dictionary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_16">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MultiDict.Card"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrderDictionaries"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</LinearLayout>

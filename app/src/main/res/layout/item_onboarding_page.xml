<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_32"
    android:paddingEnd="@dimen/space_32">

    <ImageView
        android:id="@+id/ivOnboardingIllustration"
        android:layout_width="@dimen/onboarding_illustration_size"
        android:layout_height="@dimen/onboarding_illustration_size"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvOnboardingTitle"
        style="@style/TextAppearance.MultiDict.DisplayWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvOnboardingDesc"
        style="@style/TextAppearance.MultiDict.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        android:gravity="center"
        android:textColor="@color/text_secondary" />

</LinearLayout>
